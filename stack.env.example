# Environment for the Portainer stack (docker-compose.portainer.yml). Set these
# as the stack's environment variables in Portainer, which writes them to
# stack.env; or copy this file to stack.env to run the stack by hand.
# All values here are placeholders; see docs/config.md for every option.
# DATA_DIR and WORKSPACE_DIR are fixed by the compose file; don't set them here.

# Image and host paths (used by the compose file itself)
DISPATCHER_IMAGE=registry.example.com/example-org/claude-dispatcher
DISPATCHER_TAG=latest
# Host directories (the container takes ownership of them for uid 10001)
DISPATCHER_DATA_PATH=/srv/claude-dispatcher/data
DISPATCHER_WORKSPACES_PATH=/srv/claude-dispatcher/workspaces
DISPATCHER_MEMORY_LIMIT=4g
# Existing Docker network shared with Caddy
SHARED_NETWORK=caddy_net
# Where the dashboard port is published on the host (0.0.0.0 for a remote proxy)
DISPATCHER_BIND_ADDR=127.0.0.1
DISPATCHER_HOST_PORT=8080
# Postgres and Redis for repos' tests run next to the dispatcher; the compose
# file points TEST_SERVICES at them. Set TEST_SERVICES= (empty) if you remove them.
TEST_POSTGRES_PASSWORD=postgres

# Gitea instance and the bot account (token owned by the bot)
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=replace-with-bot-token
BOT_USERNAME=claude-bot
HUMAN_REVIEWER=your-username

# What to watch (at least one)
REPOS=example-org/example-repo
ORGS=

# Claude Code auth: set one
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Common tuning (defaults shown)
POLL_INTERVAL_S=60
MAX_CONCURRENT_SESSIONS=1
CI_MAX_QUEUE=2
LOG_LEVEL=info

# Web dashboard (docs/dashboard.md). The compose file listens on 0.0.0.0 and
# publishes the port; Caddy proxies to claude-dispatcher:8080. Visitors without
# a session see only a landing page; set a token to be able to log in.
DASHBOARD_TOKEN=
# Optional link on the landing page (your blog, GitHub, …)
DASHBOARD_HOME_URL=
# Optional Plausible analytics on the dashboard (docs/dashboard.md#analytics)
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=

# Error reporting to Sentry or a Sentry-compatible server such as Bugsink
# (docs/operations.md#error-reporting). Unset DSN: off. Secret.
# The other values tell this service's events apart in a shared Sentry org.
SENTRY_DSN=
# Defaults: NODE_ENV (else production), claude-dispatcher, the hostname
SENTRY_ENVIRONMENT=
SENTRY_SERVICE_NAME=
SENTRY_INSTANCE=

# Bugsink alert intake (docs/bugsink.md): new Bugsink issues become Gitea
# issues assigned to the bot. Off unless URL, token and webhook secret are set.
# The token and secret are secrets. Projects: <bugsink project id>=owner/repo.
BUGSINK_URL=
BUGSINK_API_TOKEN=
# openssl rand -hex 32; the alert URL is <dispatcher>/hooks/bugsink/<secret>
BUGSINK_WEBHOOK_SECRET=
BUGSINK_PROJECTS=
# Defaults: true, 1 (regressions that get another attempt before freezing)
BUGSINK_ENABLED=
BUGSINK_MAX_REGRESSIONS=
