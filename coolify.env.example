# Environment for the Coolify resource (docker-compose.coolify.yml). Paste it
# into the resource's environment variables (Developer view) and fill it in.
# All values here are placeholders; see docs/config.md for every option.
# DATA_DIR, WORKSPACE_DIR and STATUS_HOST are fixed by the compose file.

# Image (used by the compose file itself). State and checkouts live in
# /srv/claude-dispatcher/data and /srv/claude-dispatcher/workspaces on the host,
# fixed by the compose file; the container takes ownership of them for uid 10001.
DISPATCHER_IMAGE=registry.example.com/example-org/claude-dispatcher
DISPATCHER_TAG=latest
DISPATCHER_CPUS=2
DISPATCHER_MEMORY_LIMIT=4g
# Postgres and Redis for repos' tests run next to the dispatcher. Use a random
# password: openssl rand -hex 16
TEST_POSTGRES_PASSWORD=

# Gitea instance and the bot account (token owned by the bot). The Gitea
# container's name on gitea_internal, which the compose file joins, or its
# public URL if Gitea runs elsewhere (docs/deploy.md#coolify).
GITEA_URL=http://gitea:3000
GITEA_TOKEN=replace-with-bot-token
BOT_USERNAME=claude-bot
HUMAN_REVIEWER=your-username
MERGE_STYLE=

# What to watch (at least one)
REPOS=example-org/example-repo
ORGS=

# Claude Code auth: set one
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Common tuning (empty: the defaults in docs/config.md)
POLL_INTERVAL_S=
MAX_CONCURRENT_SESSIONS=
CI_MAX_QUEUE=
LOG_LEVEL=

# Web dashboard (docs/dashboard.md). Set the resource's domain to
# https://<host>:8080 so Coolify's proxy routes to it.
DASHBOARD_TOKEN=
DASHBOARD_HOME_URL=
# Optional Plausible analytics on the dashboard (docs/dashboard.md#analytics)
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=

# Error reporting to Sentry or a Sentry-compatible server such as Bugsink
# (docs/operations.md#error-reporting). Unset DSN: off. Secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_SERVICE_NAME=
SENTRY_INSTANCE=

# Bugsink alert intake (docs/bugsink.md): new Bugsink issues become Gitea
# issues assigned to the bot. Off unless URL, token and webhook secret are set.
# The token and secret are secrets. Projects: <bugsink project id>=owner/repo.
BUGSINK_URL=
BUGSINK_API_TOKEN=
# openssl rand -hex 32; the alert URL is <dispatcher>/hooks/bugsink/<secret>
BUGSINK_WEBHOOK_SECRET=
BUGSINK_PROJECTS=
# Defaults: true, 1 (regressions that get another attempt before freezing)
BUGSINK_ENABLED=
BUGSINK_MAX_REGRESSIONS=
