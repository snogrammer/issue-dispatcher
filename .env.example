# Copy to .env and fill in. All values here are placeholders.
# See docs/config.md for every parameter, its default and validation rules.

# --- Required -------------------------------------------------------------
# Gitea instance and the bot account the dispatcher acts as
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=replace-with-bot-token
BOT_USERNAME=claude-bot
# Person who receives follow-up and question issues
HUMAN_REVIEWER=your-username
# Repos to watch: comma-separated owner/repo list, and/or orgs to discover (at least one)
REPOS=example-org/example-repo
ORGS=

# --- Optional (defaults shown) ---------------------------------------------
# YAML file merged underneath these env values (routing rules live there)
CONFIG_FILE=
LABEL_PREFIX=claude
POLL_INTERVAL_S=60
MAX_CONCURRENT_SESSIONS=1
MAX_FIX_ATTEMPTS=2
REQUIRE_CI=true
# merge | rebase | rebase-merge | squash | fast-forward-only (empty: each repo's default)
MERGE_STYLE=
# Don't start Claude runs while this many Actions runs are queued or running
CI_MAX_QUEUE=2
CI_NO_STATUS_TIMEOUT_MIN=15
# Usage limits: backoff when no reset time is known, and how full a usage
# window may get before new issues stop being picked up
RATE_LIMIT_BACKOFF_BASE_MIN=15
RATE_LIMIT_BACKOFF_MAX_MIN=300
RATE_LIMIT_PICKUP_THRESHOLD=0.9
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MIN=60
# bypassPermissions | acceptEdits | auto | dontAsk (default assumes the container is the sandbox)
CLAUDE_PERMISSION_MODE=bypassPermissions
# Optional per-run spending cap in USD (API-key billing)
CLAUDE_MAX_BUDGET_USD=
# Install each repo's pinned language versions (asdf) before runs
TOOLCHAIN_AUTO_INSTALL=true
TOOLCHAIN_INSTALL_TIMEOUT_MIN=20
# Services running next to the dispatcher for repos' tests, as comma-separated
# URLs; Claude is told to use them. The compose files set these to their
# Postgres and Redis containers.
TEST_SERVICES=
# Commit identity in workspaces (defaults: BOT_USERNAME and <bot>@noreply.<gitea host>)
GIT_USER_NAME=
GIT_USER_EMAIL=
# Global model/effort defaults; empty means the Claude Code CLI default
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_MAX_TURNS=100
# Models offered as model:<name> issue labels (routing-rule models are added automatically)
MODEL_LABELS=opus,sonnet,haiku
WORKSPACE_DIR=./workspaces
DATA_DIR=./data
LOG_LEVEL=info
# /healthz, /status and the web dashboard (0 turns the server off; 0.0.0.0 to
# expose outside the container)
STATUS_PORT=8080
STATUS_HOST=127.0.0.1
# Logs in to the dashboard (16+ characters, e.g. `openssl rand -hex 24`).
# Everything but the landing page and /healthz needs it; unset, the dashboard
# stays locked. Secret.
DASHBOARD_TOKEN=
# Optional link on the dashboard's landing page (your blog, GitHub, …)
DASHBOARD_HOME_URL=
# Optional Plausible analytics on the dashboard (docs/dashboard.md#analytics):
# the tracking script's https URL, and data-domain for the classic script.js
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=

# Error reporting to Sentry or a Sentry-compatible server such as Bugsink
# (docs/operations.md#error-reporting). Unset DSN: off. Secret.
# The other values tell this service's events apart in a shared Sentry org.
SENTRY_DSN=
# Defaults: NODE_ENV (else production), claude-dispatcher, the hostname
SENTRY_ENVIRONMENT=
SENTRY_SERVICE_NAME=
SENTRY_INSTANCE=

# --- Claude Code auth (passed through to the CLI; set one) -----------------
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
