# Copy to .env and fill in. All values here are placeholders.
# See docs/config.md for every parameter, its default and validation rules.

# --- Required -------------------------------------------------------------
# Gitea instance and the bot account the dispatcher acts as
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=replace-with-bot-token
BOT_USERNAME=claude-bot
# Person who receives follow-up and question issues
HUMAN_REVIEWER=your-username
# Repos to watch: comma-separated owner/repo list, and/or orgs to discover (at least one)
REPOS=example-org/example-repo
ORGS=

# --- Optional (defaults shown) ---------------------------------------------
# YAML file merged underneath these env values (routing rules live there)
CONFIG_FILE=
LABEL_PREFIX=claude
POLL_INTERVAL_S=60
MAX_CONCURRENT_SESSIONS=1
MAX_FIX_ATTEMPTS=3
REQUIRE_CI=true
CI_MAX_QUEUE=2
CI_NO_STATUS_TIMEOUT_MIN=15
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MIN=60
# Global model/effort defaults; empty means the Claude Code CLI default
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_MAX_TURNS=100
WORKSPACE_DIR=./workspaces
DATA_DIR=./data
LOG_LEVEL=info

# --- Claude Code auth (passed through to the CLI; set one) -----------------
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
